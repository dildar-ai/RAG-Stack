# ==========================================================================
# RAG Chatbot API - Environment Configuration
# Copy this file to .env and fill in the real values.
# .env is git-ignored. NEVER commit secrets.
# ==========================================================================

# --- Qdrant (vector database) ---
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# --- Groq (LLM inference) ---
GROQ_API_KEY=your-groq-api-key
# Optional: override the generation model (default: openai/gpt-oss-20b)
# Higher-quality but slower alternative: openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-20b

# --- Supabase (auth + storage + postgres) ---
SUPABASE_URL=https://your-project.supabase.co
# Public anon key - used by the API only to call the Supabase Auth /user endpoint
SUPABASE_ANON_KEY=your-anon-key
# SERVICE ROLE key - full database access, SERVER SIDE ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CORS / deployment ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- Runtime (production hardening) ---
# "production" makes the API fail fast on missing env vars and disable /docs
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Rate limits (requests per rolling minute) ---
RATE_LIMIT_CHAT_RPM=30
RATE_LIMIT_WIDGET_RPM=20
RATE_LIMIT_UPLOAD_RPM=10

# --- Upload limits ---
MAX_UPLOAD_MB=25

# --- RAG tuning (optional) ---
RAG_TOP_K=5
# MiniLM cosine threshold; hits below this are dropped before prompting
RAG_MIN_SCORE=0.10
# Adjacent PDF blocks are merged into chunks of up to this many characters
PDF_CHUNK_MERGE_CHARS=700
RAG_MAX_CHUNK_CHARS=1200
RAG_MAX_HISTORY_TURNS=6
